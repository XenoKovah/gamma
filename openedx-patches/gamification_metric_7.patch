+<script>
+$(function() {
+    $.get(
+        "${api_url}"+"points/",
+        data={"username": "${ user.username | h }"},
+        function( points ) {
+            $.get(
+                "${api_url}"+"chart/",
+                data={"username": "${ user.username | h }"},
+                function( data ) {
+                    var events = [];
+                    for (var key in data) {
+                        events.push({name: key, y : data[key]});
+                    }
+                    $('#container-chart').highcharts({
+                        chart: {
+                            plotBackgroundColor: null,
+                            plotBorderWidth: 0,
+                            plotShadow: false
+                        },
+                        title: {
+                            text: '<h1><b>'+points.points+'</b></h1>',
+                            align: 'center',
+                            verticalAlign: 'middle',
+                            y: 65
+                        },
+                        tooltip: {
+                            pointFormat: '{series.name}: <b>{point.percentage:.1f}%</b>'
+                        },
+                        plotOptions: {
+                            pie: {
+                                dataLabels: {
+                                    enabled: true,
+                                    distance: -50,
+                                    style: {
+                                        fontWeight: 'bold',
+                                        color: 'white'
+                                    }
+                                },
+                                startAngle: -90,
+                                endAngle: 90,
+                                center: ['50%', '75%']
+                            }
+                        },
+                        series: [{
+                            type: 'pie',
+                            name: 'Browser share',
+                            innerSize: '50%',
+                            data: events
+                        }]
+                    });
+                }
+            );
+        }
+    );
+});
+</script>
+
+<script>
+$(function () {
+    $.get(
+        "${api_url}"+"progress/",
+        data={"username": "${ user.username | h }"},
+        function( data ) {
+            var points_by_day = [];
+            var accumulative_data = [];
+            for (var i in data) {
+                points_by_day.push([Date.parse(data[i].date), data[i].points]);
+                var accum = 0;
+                if (accumulative_data.length != 0) {
+                    accum = accumulative_data[accumulative_data.length-1][1] + data[i].points;
+                }
+                else {
+                    accum = data[i].points;
+                }
+                accumulative_data.push([Date.parse(data[i].date), accum]);
+            }
+
+            $('#container-progress').highcharts({
+                chart: {
+                    type: 'spline'
+                },
+                title: {
+                    text: 'Student progress'
+                },
+                subtitle: {
+                    text: 'Shows Student points by day'
+                },
+                xAxis: {
+                    type: 'datetime',
+                    dateTimeLabelFormats: {
+                        month: '%e. %b',
+                        year: '%b'
+                    },
+                    title: {
+                        text: 'Date'
+                    }
+                },
+                yAxis: [{
+                    title: {
+                        text: null
+                    },
+                    labels: {
+                        align: 'left',
+                        x: 3,
+                        y: 16,
+                        format: '{value:.,0f}'
+                    },
+                    showFirstLabel: false
+                }, {
+                    gridLineWidth: 0,
+                    opposite: true,
+                    title: {
+                        text: null
+                    },
+                    labels: {
+                        align: 'right',
+                        x: -3,
+                        y: 16,
+                        format: '{value:.,0f}'
+                    },
+                    showFirstLabel: false
+                }],
+                tooltip: {
+                    headerFormat: '<b>{series.name}</b><br>',
+                    pointFormat: '{point.x:%e. %b}: {point.y:.2f}'
+                },
+
+                plotOptions: {
+                    spline: {
+                        marker: {
+                            enabled: true
+                        }
+                    }
+                },
+
+                series: [{
+                    name: 'Student progress',
+                    type: 'column',
+                    data: points_by_day
+                },
+                {
+                    name: 'Accumulative progress',
+                    type: 'area',
+                    yAxis: 1,
+                    data: accumulative_data
+                }]
+            });
+        }
+    );
+});
+</script>
+<script>
+$(function() {
+    $.get(
+        "${api_url}"+"badges/",
+        data={"username": "${ user.username | h }"},
+        function( data ) {
+            for (i in data) {
+                $('#container-badges').append(
+                    '<img src="'+data[0].url+'" alt="Smiley face" height="100" width="100">'
+                );
+            }
+        }
+    );
+});
+</script>
