new file mode 100644
index 0000000..376b570
--- /dev/null
+++ b/common/djangoapps/gamification_metric/tasks.py
@@ -0,0 +1,8 @@
+from celery.task import task
+
+from api_calls import APICalls
+
+
+@task()
+def send_api_request(data):
+    APICalls().api_call(**data)
