             'uid': '{}_{}'.format(instance.user.pk, course_id),
         }
-        send_api_request.delay(data)
+        # Return back using Celery with delay after tesing
+        send_api_request(data)
diff --git a/common/djangoapps/gamification_metric/tasks.py b/common/djangoapps/gamification_metric/tasks.py
index 376b570..df4deea 100644
--- a/common/djangoapps/gamification_metric/tasks.py
+++ b/common/djangoapps/gamification_metric/tasks.py
