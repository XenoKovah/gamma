# Celery
CELERY_BROKER_URL=amqp://guest@rabbit
CELERY_RESULT_BACKEND=redis://redis:6379

# DB
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# Django
# For devstack use DJANGO_SETTINGS_MODULE=gamma.settings.devstack
DJANGO_SETTINGS_MODULE=gamma.settings.devstack

# React
# Optional react backend base url
REACT_APP_LOCALHOST=http://0.0.0.0:9000

# EDX integrarion
EDX_LMS_BASE_URL=http://<LOCAL_IP_ADDRESS>:18000
EDX_API_KEY="PUT_YOUR_API_KEY_HERE"

# SSO with LMS setup
OAUTH2_PROVIDER_URL=http://<LOCAL_IP_ADDRESS>:18000/oauth2
SOCIAL_AUTH_EDX_OAUTH2_KEY=<rgg_dot_app_client_id>
SOCIAL_AUTH_EDX_OAUTH2_SECRET=<rgg_dot_app_client_secret>
SOCIAL_AUTH_EDX_OAUTH2_URL_ROOT=http://<LOCAL_IP_ADDRESS>:18000
SOCIAL_AUTH_EDX_OAUTH2_LOGOUT_URL=http://<LOCAL_IP_ADDRESS>:18000/logout
