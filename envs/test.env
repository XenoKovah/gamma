# Celery
CELERY_BROKER_URL=amqp://guest@rabbit
CELERY_RESULT_BACKEND=redis://redis:6379

# DB
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

MONGO_URL=mongodb://mongo:27017/
MONGO_DATABASE=gamma_data_test

# Django
# For devstack use DJANGO_SETTINGS_MODULE=gamma.settings.devstack
DJANGO_SETTINGS_MODULE=gamma.settings.test

# EDX integrarion
EDX_LMS_BASE_URL=<edx_base_url>
EDX_API_KEY=<edx_api_key>

EDX_NOTIFICATION_API_SUFFIX=notifications/api/v0/send-notification/
EDX_NOTIFICATION_ENABLED=True

# Testing envs
PYTHONBREAKPOINT=ipdb.set_trace
