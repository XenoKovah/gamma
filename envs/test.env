# Celery
CELERY_BROKER_URL=amqp://guest@rabbit
CELERY_RESULT_BACKEND=redis://redis:6379

# DB
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# Django
# For devstack use DJANGO_SETTINGS_MODULE=gamma.settings.devstack
DJANGO_SETTINGS_MODULE=gamma.settings.test

# EDX integrarion
EDX_LMS_BASE_URL=<edx_base_url>
EDX_API_KEY=<edx_api_key>

# SSO with LMS setup
OAUTH2_PROVIDER_URL=<lms_base_url>/oauth2
SOCIAL_AUTH_EDX_OAUTH2_KEY=<rgg_dot_app_client_id>
SOCIAL_AUTH_EDX_OAUTH2_SECRET=<rgg_dot_app_client_secret>
SOCIAL_AUTH_EDX_OAUTH2_URL_ROOT=<lms_base_url>
SOCIAL_AUTH_EDX_OAUTH2_LOGOUT_URL=<lms_base_url>/logout

# Testing envs
PYTHONBREAKPOINT=ipdb.set_trace
